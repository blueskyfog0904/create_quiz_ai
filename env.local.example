NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:4000
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Point-charge payments (server secrets must never use NEXT_PUBLIC_)
PAYMENTS_ENABLED=true
PAYAPP_USERID=your_payapp_seller_id
PAYAPP_LINKKEY=your_payapp_link_key
PAYAPP_LINKVAL=your_payapp_link_value

KAKAOPAY_PAYMENTS_ENABLED=false
KAKAOPAY_ENVIRONMENT=test
KAKAOPAY_CID=TC0ONETIME
KAKAOPAY_SECRET_KEY=your_test_kakaopay_secret_key
PAYMENT_CALLBACK_ORIGIN=https://www.summersuninst.com
PAYMENT_PARTNER_USER_SECRET=replace_with_a_random_server_secret
CRON_SECRET=replace_with_a_random_server_token
